{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sfts-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "551308f8193d47db9cb6452be395c68f"
    }
  ],
  "secrets": {
    "required": ["JWT_SECRET"]
  },
  "vars": {
    "NODE_ENV": "production",
    "JWT_EXPIRES_IN": "7d",
    "DEV_RESET_ENABLED": "false",
    "CORS_ORIGINS": ""
  },
  "alias": {
    "express": "./src/worker-express.js"
  }
}