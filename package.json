{
  "name": "sfts-backend",
  "version": "1.0.0",
  "description": "Smart Fitness Tracking System - REST API backend (Node.js/Express/PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "service:start": "./scripts/sfts-backend-service.sh start",
